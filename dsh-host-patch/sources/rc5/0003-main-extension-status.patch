+it('reports installed, failed, missing and replaced packages without exposing paths or errors', async () => {
+  const root = await fixture({ good: '*', bad: '*', invalid: '*' })
+  const good = await plugin(root, 'good', './entry.mjs')
+  await writeFile(join(good, 'package.json'), JSON.stringify({ type: 'module', version: '1.0.0', dsh: { desktop: { main: './entry.mjs' } } }))
+  await writeFile(join(good, 'helper.mjs'), 'export const value = 1')
+  await plugin(root, 'bad', './entry.mjs', 'export function start() { throw new Error("private /path/token") }')
+  await plugin(root, 'invalid', '../entry.mjs')
+  vi.spyOn(console, 'error').mockImplementation(() => {})
+  const app = new EventEmitter() as App
+  const extensions = await startDesktopMainExtensions(root, {
+    app, webContents: {} as DesktopMainExtensionApi['webContents'], mainWindow: () => undefined, dshHome: root,
+  })
+  expect(await extensions.status('good')).toEqual({ state: 'loaded', version: '1.0.0', loadedAt: expect.any(String) })
+  expect(await extensions.status('bad')).toEqual({ state: 'failed', code: 'EXTENSION_START_FAILED' })
+  expect(await extensions.status('invalid')).toEqual({ state: 'failed', code: 'EXTENSION_ENTRY_INVALID' })
+  expect(await extensions.status('../good')).toEqual({ state: 'failed', code: 'EXTENSION_ENTRY_INVALID' })
+  expect(await extensions.status('absent')).toEqual({ state: 'not-installed', code: 'EXTENSION_NOT_INSTALLED' })
+  await writeFile(join(good, 'helper.mjs'), 'export const value = 2')
+  expect(await extensions.status('good')).toEqual({ state: 'pending-restart', version: '1.0.0', code: 'EXTENSION_RESTART_REQUIRED' })
+  await plugin(root, 'new', './entry.mjs')
+  await writeFile(join(root, 'package.json'), JSON.stringify({ dependencies: { good: '*', new: '*' } }))
+  expect(await extensions.status('new')).toEqual({ state: 'pending-restart', code: 'EXTENSION_RESTART_REQUIRED' })
+  expect(await extensions.status('bad')).toEqual({ state: 'pending-restart', code: 'EXTENSION_RESTART_REQUIRED' })
+  extensions()
+})
