Date: Fri, 20 Nov 2026 15:05:30 +0000
Subject: [PATCH] fix(desktop): preserve host-only cookie identity in session
 recovery

Co-Authored-By: Devin AI <158243242+devin-ai-integration[bot]@users.noreply.github.com>
---
 apps/desktop/src/sidebar-session-cookies.ts   |  4 ++--
 .../tests/sidebar-session-cookies.spec.ts     | 23 ++++++++++++++++---
 2 files changed, 22 insertions(+), 5 deletions(-)

diff --git a/apps/desktop/src/sidebar-session-cookies.ts b/apps/desktop/src/sidebar-session-cookies.ts
index e33ac289b4..6e0b2f7471 100644
--- a/apps/desktop/src/sidebar-session-cookies.ts
+++ b/apps/desktop/src/sidebar-session-cookies.ts
@@ -29,8 +29,8 @@ function details(cookie: SavedCookie): CookiesSetDetails {
     ...cookie.hostOnly ? {} : { domain: cookie.domain } }
 }
 
-function key(cookie: Pick<Cookie, 'domain' | 'path' | 'name'>): string {
-  return JSON.stringify([cookie.domain?.replace(/^\./, '').toLowerCase(), cookie.path, cookie.name])
+function key(cookie: Pick<Cookie, 'domain' | 'hostOnly' | 'path' | 'name'>): string {
+  return JSON.stringify([cookie.hostOnly === true, cookie.domain?.replace(/^\./, '').toLowerCase(), cookie.path, cookie.name])
 }
 
 /** Partition-local session-cookie checkpoints; Chromium retains expiring cookies. */
diff --git a/apps/desktop/tests/sidebar-session-cookies.spec.ts b/apps/desktop/tests/sidebar-session-cookies.spec.ts
index d9206d348d..3c1b3cc550 100644
--- a/apps/desktop/tests/sidebar-session-cookies.spec.ts
+++ b/apps/desktop/tests/sidebar-session-cookies.spec.ts
@@ -73,15 +73,32 @@ it('restores domain scope and URL-encodes path characters without changing the c
     secure: true, httpOnly: true, sameSite: 'strict' })
 })
 
-it('does not overwrite a persistent replacement with a stale session snapshot', async () => {
-  const f = await fixture([{ ...login, value: 'persistent-replacement', session: false, expirationDate: 2e10 }])
-  await writeFile(f.file, JSON.stringify({ version: 1, cookies: [login] }))
+it.each([true, false])('does not overwrite a persistent replacement with matching hostOnly=%s', async (hostOnly) => {
+  const cookie = { ...login, hostOnly, domain: hostOnly ? 'example.com' : '.example.com' }
+  const f = await fixture([{ ...cookie, value: 'persistent-replacement', session: false, expirationDate: 2e10 }])
+  await writeFile(f.file, JSON.stringify({ version: 1, cookies: [cookie] }))
   await f.store.restore()
   expect(f.cookies.set).not.toHaveBeenCalled()
   expect(f.values[0]?.value).toBe('persistent-replacement')
   expect((await snapshot(f.file)).cookies).toEqual([])
 })
 
+it.each([true, false])('restores a session cookie beside a different-scope persistent hostOnly=%s cookie', async (hostOnly) => {
+  const persistent = { ...login, hostOnly, domain: hostOnly ? 'example.com' : '.example.com',
+    value: 'persistent-replacement', session: false, expirationDate: 2e10 }
+  const saved = { ...login, hostOnly: !hostOnly, domain: hostOnly ? '.example.com' : 'example.com' }
+  const f = await fixture([persistent])
+  await writeFile(f.file, JSON.stringify({ version: 1, cookies: [saved] }))
+  await f.store.restore()
+  expect(f.cookies.set).toHaveBeenCalledOnce()
+  expect(f.values).toEqual([persistent, saved])
+  expect((await snapshot(f.file)).cookies).toEqual([saved])
+  const restarted = await fixture([persistent], f.home)
+  await restarted.store.restore()
+  expect(restarted.values).toEqual([persistent, saved])
+  expect((await snapshot(f.file)).cookies).toEqual([saved])
+})
+
 it.each(['overwrite', 'expired-overwrite', 'expired', 'explicit', 'evicted'])('reconciles %s removals from a complete enumeration', async (cause) => {
   const f = await fixture([login])
   await f.store.restore()
