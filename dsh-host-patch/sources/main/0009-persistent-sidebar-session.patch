diff --git a/apps/desktop/tests/browser-partitions.spec.ts b/apps/desktop/tests/browser-partitions.spec.ts
new file mode 100644
index 0000000000..a62edbd199
--- /dev/null
+++ b/apps/desktop/tests/browser-partitions.spec.ts
@@ -0,0 +1,25 @@
+import { expect, it, vi } from 'vitest'
+import type { WebContents } from 'electron'
+import { DesktopBrowserGuests } from '../src/browser-guests.ts'
+
+vi.mock('electron', () => ({ app: {}, session: { fromPartition: vi.fn(() => ({
+  setPermissionRequestHandler() {}, setPermissionCheckHandler() {}, setDevicePermissionHandler() {},
+  setDisplayMediaRequestHandler() {}, on() {}, webRequest: { onBeforeRequest() {} },
+})) } }))
+
+it('shares persistent storage across workspaces and process owners only within the same DSH_HOME', () => {
+  const owner = {} as WebContents
+  const first = new DesktopBrowserGuests(() => undefined, '/profiles/one')
+  const restarted = new DesktopBrowserGuests(() => undefined, '/profiles/one')
+  const other = new DesktopBrowserGuests(() => undefined, '/profiles/two')
+  const a = first.acquire(owner, 'workspace-a', true)
+  expect(a.partition).toMatch(/^persist:dsh-sidebar-browser-[a-f0-9]{64}$/)
+  expect(first.acquire(owner, 'workspace-b', true).partition).toBe(a.partition)
+  expect(restarted.acquire(owner, 'workspace-c', true).partition).toBe(a.partition)
+  expect(other.acquire(owner, 'workspace-a', true).partition).not.toBe(a.partition)
+  expect(first.acquire(owner, 'workspace-a').partition).not.toBe(a.partition)
+  expect(first.acquire(owner, 'workspace-a').partition).not.toMatch(/^persist:/)
+  expect(() => first.acquire(owner, '', true)).toThrow('workspace storage identity')
+  expect(() => new DesktopBrowserGuests(() => undefined).acquire(owner, 'workspace', true))
+    .toThrow('Persistent Sidebar storage is unavailable')
+})
