diff --git a/packages/client/ui-sidebar-right/tests/native-slots.client.spec.ts b/packages/client/ui-sidebar-right/tests/native-slots.client.spec.ts
new file mode 100644
index 0000000000..81530a6b40
--- /dev/null
+++ b/packages/client/ui-sidebar-right/tests/native-slots.client.spec.ts
@@ -0,0 +1,89 @@
+// @vitest-environment jsdom
+import { afterEach, expect, it, vi } from 'vitest'
+import type { SessionId } from '@deepseek-ai/dsh-session/types'
+import type { TabId } from '@deepseek-ai/dsh-client-ui-dockkit'
+import type { SidebarNativeSlot, SidebarNativeSlots } from '../src/client/contract/native-slots.ts'
+import { SidebarNativeComposition } from '../src/client/native-slots.ts'
+
+const owner = 'owner' as SessionId, tab = 'tab' as TabId, slot = 'slot' as SidebarNativeSlot
+const scope = 'dsh-tab:v1:' + encodeURIComponent(JSON.stringify([owner, 'sidebar', tab]))
+const lifetimes: AbortController[] = []
+afterEach(() => { lifetimes.splice(0).forEach(value => value.abort()); document.body.replaceChildren(); vi.unstubAllGlobals() })
+
+function fixture() {
+  vi.stubGlobal('ResizeObserver', class { observe() {} disconnect() {} })
+  const bridge: SidebarNativeSlots = { enter: vi.fn(async () => 'admission'), leave: vi.fn(async () => {}),
+    register: vi.fn(async () => slot), update: vi.fn(async () => {}), revoke: vi.fn(async () => {}) }
+  const service = new SidebarNativeComposition(bridge)
+  const root = document.createElement('div'), viewport = document.createElement('div')
+  viewport.id = 'native-viewport'; root.append(viewport); document.body.append(root)
+  vi.spyOn(viewport, 'getBoundingClientRect').mockReturnValue(new DOMRect(20, 30, 400, 300))
+  const lifetime = new AbortController(); lifetimes.push(lifetime)
+  return { service, bridge, root, viewport, lifetime,
+    register: () => service.register(owner, tab, scope, viewport.id, lifetime.signal) }
+}
+
+it('rejects missing composition, unmounted roots and foreign DOM without invoking native registration', async () => {
+  const f = fixture()
+  await expect(f.register()).rejects.toMatchObject({ code: 'BROWSER_SLOT_UNAVAILABLE' })
+  const unmount = f.service.mount(owner, f.root)
+  document.body.append(f.viewport)
+  await expect(f.register()).rejects.toMatchObject({ code: 'BROWSER_SLOT_UNAVAILABLE' })
+  expect(f.bridge.register).not.toHaveBeenCalled()
+  unmount()
+})
+
+it('refuses a scope naming another owner or tab before admitting a native slot', async () => {
+  const f = fixture(), unmount = f.service.mount(owner, f.root)
+  for (const address of [['other', 'sidebar', tab], [owner, 'sidebar', 'other']]) {
+    await expect(f.service.register(owner, tab, 'dsh-tab:v1:' + encodeURIComponent(JSON.stringify(address)), f.viewport.id, f.lifetime.signal))
+      .rejects.toMatchObject({ code: 'BROWSER_OWNER_UNKNOWN' })
+  }
+  expect(f.bridge.register).not.toHaveBeenCalled()
+  unmount()
+})
+
+it('admits from the committed root reference and publishes geometry without animation frames', async () => {
+  const f = fixture(), unmount = f.service.mount(owner, f.root)
+  expect(await f.register()).toBe(slot)
+  expect(f.bridge.enter).toHaveBeenCalledWith(owner)
+  expect(f.bridge.register).toHaveBeenCalledWith('admission', scope)
+  expect(f.bridge.update).toHaveBeenCalledWith(slot, { x: 20, y: 30, width: 400, height: 300, visible: true, background: false })
+  f.root.dataset.sidebarRightBackgroundRendering = 'true'
+  await vi.waitFor(() => expect(f.bridge.update).toHaveBeenLastCalledWith(slot,
+    expect.objectContaining({ visible: false, background: true })))
+  unmount()
+  await vi.waitFor(() => expect(f.bridge.revoke).toHaveBeenCalledTimes(1))
+  expect(f.bridge.leave).toHaveBeenCalledWith('admission')
+})
+
+it('cancellation revokes exactly once, and aborted work never admits a new native slot', async () => {
+  const f = fixture(), unmount = f.service.mount(owner, f.root)
+  await f.register(); f.lifetime.abort(); unmount()
+  await vi.waitFor(() => expect(f.bridge.revoke).toHaveBeenCalledTimes(1))
+  const next = fixture(); next.service.mount(owner, next.root); next.lifetime.abort()
+  f.viewport.removeAttribute('id')
+  await expect(next.register()).rejects.toMatchObject({ name: 'AbortError' })
+  expect(next.bridge.register).not.toHaveBeenCalled()
+})
+
+it('revokes registration that finishes after its root was disposed', async () => {
+  const f = fixture()
+  let finish!: (value: SidebarNativeSlot) => void
+  vi.mocked(f.bridge.register).mockImplementation(() => new Promise((resolve) => { finish = resolve }))
+  const unmount = f.service.mount(owner, f.root), pending = f.register()
+  await vi.waitFor(() => expect(f.bridge.register).toHaveBeenCalledTimes(1))
+  unmount(); finish(slot)
+  await expect(pending).rejects.toMatchObject({ name: 'AbortError' })
+  await vi.waitFor(() => expect(f.bridge.revoke).toHaveBeenCalledTimes(1))
+})
+
+it('revokes placement failure instead of leaving observers or a usable native slot', async () => {
+  const f = fixture(), unmount = f.service.mount(owner, f.root)
+  vi.spyOn(console, 'error').mockImplementation(() => {})
+  vi.mocked(f.bridge.update).mockRejectedValueOnce(new Error('composition was revoked'))
+  await expect(f.register()).rejects.toThrow('composition was revoked')
+  await vi.waitFor(() => expect(f.bridge.revoke).toHaveBeenCalledTimes(1))
+  unmount()
+  vi.restoreAllMocks()
+})
