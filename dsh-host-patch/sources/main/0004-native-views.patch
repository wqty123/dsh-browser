diff --git a/packages/client/ui-sidebar-right/src/client/native-slots.ts b/packages/client/ui-sidebar-right/src/client/native-slots.ts
new file mode 100644
index 0000000000..d59a3478ab
--- /dev/null
+++ b/packages/client/ui-sidebar-right/src/client/native-slots.ts
@@ -0,0 +1,99 @@
+/** Sidebar-owned composition admissions and CSS-pixel placement observation. */
+import type { SessionId } from '@deepseek-ai/dsh-session/types'
+import type { TabId } from '@deepseek-ai/dsh-client-ui-dockkit'
+import { HarnessError } from '@deepseek-ai/dsh-error'
+import type { SidebarNativeSlot, SidebarNativeSlots, SidebarNativePlacement } from './contract/native-slots.ts'
+
+interface Root {
+  readonly element: HTMLElement
+  readonly admission: Promise<string>
+  readonly lifetime: AbortController
+}
+
+/** Owns native admissions for committed Session roots, not renderer DOM attributes. */
+export class SidebarNativeComposition {
+  private readonly roots = new Map<SessionId, Root>()
+
+  constructor(private readonly bridge: SidebarNativeSlots | undefined) {}
+
+  mount(owner: SessionId, element: HTMLElement): () => void {
+    if (this.bridge === undefined) return () => {}
+    const bridge = this.bridge
+    const root: Root = { element, admission: bridge.enter(owner), lifetime: new AbortController() }
+    this.roots.set(owner, root)
+    void root.admission.catch(error => console.error('Sidebar native admission failed', error))
+    return () => {
+      if (this.roots.get(owner) === root) this.roots.delete(owner)
+      root.lifetime.abort()
+      void root.admission.then(id => bridge.leave(id)).catch(error => console.error('Sidebar native revocation failed', error))
+    }
+  }
+
+  async register(owner: SessionId, tab: TabId, scope: string, viewportId: string, signal: AbortSignal): Promise<SidebarNativeSlot> {
+    let address: unknown
+    try { address = scope.startsWith('dsh-tab:v1:') ? JSON.parse(decodeURIComponent(scope.slice(11))) : undefined }
+    catch (_error) { throw new HarnessError('Native Sidebar scope is invalid', 'BROWSER_HANDLE_STALE') }
+    if (!Array.isArray(address) || address.length !== 3 || address[0] !== owner || address[2] !== tab) {
+      throw new HarnessError('Native Sidebar scope does not own this tab', 'BROWSER_OWNER_UNKNOWN')
+    }
+    await Promise.resolve()
+    const bridge = this.bridge, root = this.roots.get(owner), element = document.getElementById(viewportId)
+    if (bridge === undefined || root === undefined || element === null || !root.element.contains(element)) {
+      throw new HarnessError('Native Sidebar viewport is unavailable', 'BROWSER_SLOT_UNAVAILABLE')
+    }
+    signal.throwIfAborted()
+    root.lifetime.signal.throwIfAborted()
+    const id = await bridge.register(await root.admission, scope)
+    let ended = false
+    let previous = ''
+    let queue = Promise.resolve()
+    const placement = (): SidebarNativePlacement => {
+      const rectangle = element.getBoundingClientRect()
+      let left = Math.max(0, rectangle.left), top = Math.max(0, rectangle.top)
+      let right = Math.min(innerWidth, rectangle.right), bottom = Math.min(innerHeight, rectangle.bottom)
+      let drawn = element.isConnected
+      for (let node: HTMLElement | null = element; node !== null; node = node.parentElement) {
+        const style = getComputedStyle(node)
+        if (node.hidden || style.display === 'none' || style.visibility === 'hidden') drawn = false
+        if (/(hidden|clip|auto|scroll)/.test(style.overflowX + style.overflowY)) {
+          const bounds = node.getBoundingClientRect()
+          left = Math.max(left, bounds.left); top = Math.max(top, bounds.top)
+          right = Math.min(right, bounds.right); bottom = Math.min(bottom, bounds.bottom)
+        }
+      }
+      const background = root.element.dataset.sidebarRightBackgroundRendering === 'true'
+      return { x: left, y: top, width: Math.max(0, right - left), height: Math.max(0, bottom - top),
+        visible: drawn && !background, background: drawn && background }
+    }
+    const update = (): void => {
+      if (ended) return
+      const value = placement(), serialized = JSON.stringify(value)
+      if (serialized === previous) return
+      previous = serialized
+      queue = queue.then(() => { if (!ended) return bridge.update(id, value) })
+      void queue.catch((error) => { release(); console.error('Sidebar native placement failed', error) })
+    }
+    const resize = new ResizeObserver(update), mutation = new MutationObserver(update)
+    resize.observe(element)
+    mutation.observe(document.documentElement, { subtree: true, attributes: true, attributeFilter: ['hidden', 'style', 'class', 'data-sidebar-right-background-rendering'] })
+    window.addEventListener('resize', update)
+    document.addEventListener('scroll', update, true)
+    const release = (): void => {
+      if (ended) return
+      ended = true
+      resize.disconnect(); mutation.disconnect()
+      window.removeEventListener('resize', update)
+      document.removeEventListener('scroll', update, true)
+      signal.removeEventListener('abort', release)
+      root.lifetime.signal.removeEventListener('abort', release)
+      void queue.catch((_error) => {}).then(() => bridge.revoke(id)).catch(error => console.error('Sidebar native slot release failed', error))
+    }
+    signal.addEventListener('abort', release, { once: true })
+    root.lifetime.signal.addEventListener('abort', release, { once: true })
+    update()
+    try { await queue }
+    catch (error) { release(); throw error }
+    if (signal.aborted || root.lifetime.signal.aborted) { release(); signal.throwIfAborted(); root.lifetime.signal.throwIfAborted() }
+    return id
+  }
+}
