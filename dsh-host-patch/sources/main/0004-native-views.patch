+    webContents = new Guest()
+    constructor(options: object) { super(); electron.options.push(options); electron.guests.push(this.webContents) }
+  } }
+})
+
+const scope = (owner = 'owner', tab = 'tab') => `dsh-tab:v1:${encodeURIComponent(JSON.stringify([owner, 'browser-session', tab]))}`
+const placement = { x: 5, y: 10, width: 400, height: 300, visible: true, background: false }
+const services: { service: DesktopNativeViews; renderer: WebContents }[] = []
