+const electron = vi.hoisted(() => ({ guests: [] as Guest[], options: [] as object[] }))
+vi.mock('electron', async () => {
+  const { EventEmitter } = await import('node:events')
+  class Guest extends EventEmitter {
+    dead = false
+    debugger = { attach: vi.fn(), isAttached: () => true,
+      sendCommand: vi.fn(async () => ({ frameTree: { frame: { id: 'frame', loaderId: 'loader' } } })) }
+    isDestroyed() { return this.dead }
+    getURL() { return 'https://example.test/' }
+    getTitle() { return 'Example' }
+    close() { if (!this.dead) { this.dead = true; this.emit('destroyed') } }
+  }
+  class View {
+    addChildView = vi.fn()
+    removeChildView = vi.fn()
+    setBounds = vi.fn()
+    setVisible = vi.fn()
+  }
