+    }).finally(() => { this.releasing.delete(id as DesktopNativeLease) })
+    this.releasing.set(id as DesktopNativeLease, { renderer, completion })
+    return completion
+  }
+
+  /** Trusted main extensions can enumerate only admitted native surfaces of the primary window. */
+  snapshot(): readonly { scope: string; lease: DesktopNativeLease; state: DesktopNativeState; url: string; title: string }[] {
+    const renderer = this.window()?.webContents
+    return [...this.views].filter(([, native]) => native.renderer === renderer && native.slot !== undefined)
+      .map(([lease, native]) => ({ scope: native.scope, lease, state: { ...native.state },
+        url: native.view.webContents.getURL(), title: native.view.webContents.getTitle() }))
+  }
+
+  /** Release only the lease bound to this canonical scope. */
+  async scopedRelease(scope: string, lease: DesktopNativeLease): Promise<void> {
+    const renderer = this.window()?.webContents
+    if (renderer === undefined) return refuse('BROWSER_NATIVE_SURFACE_UNAVAILABLE')
+    const native = this.views.get(lease)
+    if (native === undefined) return
+    if (native.scope !== tab(scope).wire || native.renderer !== renderer) return refuse('BROWSER_OWNER_UNKNOWN')
+    await this.release(renderer, lease)
+  }
+
+  /** Download through the same scoped guest session and its network policy. */
+  async scopedFetch(scope: string, lease: DesktopNativeLease, url: string, signal: AbortSignal): Promise<Response> {
+    const renderer = this.window()?.webContents
+    if (renderer === undefined) return refuse('BROWSER_NATIVE_SURFACE_UNAVAILABLE')
+    const native = this.native(renderer, lease)
+    if (native.scope !== tab(scope).wire) return refuse('BROWSER_OWNER_UNKNOWN')
+    if (!this.policy.allowedNavigation(url)) return refuse('BROWSER_URL_DENIED')
+    return native.view.webContents.session.fetch(url, { credentials: 'include', signal })
+  }
+
+  /** Resolve the scoped binding again at dispatch, rather than exposing Electron guests. */
+  async scopedCommand(scope: string, lease: DesktopNativeLease, method: string, params?: object): Promise<object> {
+    const renderer = this.window()?.webContents
+    if (renderer === undefined) return refuse('BROWSER_NATIVE_SURFACE_UNAVAILABLE')
+    const native = this.native(renderer, lease)
+    if (native.scope !== tab(scope).wire) return refuse('BROWSER_OWNER_UNKNOWN')
+    return this.command(renderer, lease, method, params)
+  }
+
+  private detach(native: Native): void {
+    const window = this.window()
+    if (window !== undefined && !window.isDestroyed()) window.contentView.removeChildView(native.container)
+  }
+
+  private async revoke(renderer: WebContents, id: unknown): Promise<void> {
+    if (typeof id !== 'string' || !this.slots.has(id as SidebarNativeSlot)) return
+    const slot = this.slot(renderer, id)
+    this.slots.delete(id as SidebarNativeSlot)
+    for (const [lease, native] of this.views) {
+      if (native.renderer === renderer && native.scope === slot.scope) await this.release(renderer, lease)
+    }
+  }
+
+  /** Revoke admissions before releasing native objects on owner navigation or death. */
+  bind(window: BrowserWindow): void {
+    const renderer = window.webContents
+    const revoke = (): void => {
+      for (const [id, admission] of this.admissions) if (admission.renderer === renderer) this.admissions.delete(id)
+      for (const [id, slot] of this.slots) if (slot.renderer === renderer) this.slots.delete(id)
+      for (const [id, native] of this.views) {
+        if (native.renderer === renderer) void this.release(renderer, id).catch(error => console.error(error))
+      }
+    }
+    renderer.on('did-start-navigation', (_event, _url, inPlace, mainFrame) => { if (mainFrame && !inPlace) revoke() })
+    renderer.on('render-process-gone', revoke)
+    renderer.once('destroyed', revoke)
+  }
+}
