+  bindNative(owner: WebContents, id: DesktopBrowserLeaseId, guest: WebContents): void {
+    const lease = this.leases.get(id)
+    if (lease === undefined || lease.owner !== owner || lease.attached) throw new HarnessError('Invalid native reservation', 'BROWSER_OWNER_UNKNOWN')
+    lease.attached = true
+    lease.guest = guest
