+  const owner = Object.assign(new EventEmitter(), { isDestroyed: () => false, send: vi.fn(), getZoomFactor: () => 1 })
+  const renderer = owner as WebContents
+  const window = { webContents: renderer, isDestroyed: () => false,
+    getContentBounds: () => ({ width: 1000, height: 800 }),
+    contentView: { addChildView: vi.fn(), removeChildView: vi.fn() } }
