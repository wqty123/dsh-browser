+    slot.lease = id as DesktopNativeLease
+    this.compose(native, slot)
+    clearTimeout(native.documentTimer)
+    this.publish(id as DesktopNativeLease, native, native.state)
+  }
+
+  private compose(native: Native, slot: Slot): void {
+    const window = this.window(), placement = slot.placement
+    if (window === undefined || window.isDestroyed() || placement === undefined || native.renderer !== window.webContents) return refuse('BROWSER_NATIVE_SURFACE_UNAVAILABLE')
+    const zoom = window.webContents.getZoomFactor()
+    const bounds = window.getContentBounds()
+    const x = Math.max(0, Math.min(bounds.width, Math.round(placement.x * zoom)))
+    const y = Math.max(0, Math.min(bounds.height, Math.round(placement.y * zoom)))
+    const width = Math.max(0, Math.min(bounds.width - x, Math.round(placement.width * zoom)))
+    const height = Math.max(0, Math.min(bounds.height - y, Math.round(placement.height * zoom)))
