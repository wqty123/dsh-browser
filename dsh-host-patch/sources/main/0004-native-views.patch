index 0000000000..52f4ec0c7c
--- /dev/null
+++ b/apps/desktop/src/native-views.ts
@@ -0,0 +1,372 @@
+/** Primary-renderer slot admission and main-owned native Sidebar presentation. */
+import { randomUUID } from 'node:crypto'
+import { WebContentsView, View, type BrowserWindow, type WebContents } from 'electron'
+import { HarnessError } from '@deepseek-ai/dsh-error'
+import type { DesktopBrowserLeaseId, DesktopNativeLease, DesktopNativeState, SidebarNativeSlot, SidebarNativePlacement } from '@deepseek-ai/dsh-client-ui-sidebar-browser/types'
+import type { DesktopBrowserGuests } from './browser-guests.ts'
+import { DESKTOP_IPC } from './ipc.ts'
+
+type Failure = 'BROWSER_NATIVE_SURFACE_UNAVAILABLE' | 'BROWSER_OWNER_UNKNOWN' | 'BROWSER_SLOT_UNAVAILABLE'
+  | 'BROWSER_HANDLE_STALE' | 'BROWSER_GUEST_CLOSED' | 'BROWSER_DOCUMENT_UNACKNOWLEDGED'
+  | 'BROWSER_DOCUMENT_TIMEOUT' | 'BROWSER_COMMAND_DENIED' | 'BROWSER_URL_DENIED'
+
+export class DesktopNativeViewError extends HarnessError {
+  constructor(code: Failure) { super(code, code) }
+}
+
+function refuse(code: Failure): never { throw new DesktopNativeViewError(code) }
+
+function record(value: unknown): Record<string, unknown> {
+  if (typeof value !== 'object' || value === null || Array.isArray(value)) return refuse('BROWSER_COMMAND_DENIED')
+  return value as Record<string, unknown>
+}
+
+/** Parse the plugin's canonical address without treating its owner field as authorization. */
+function tab(value: unknown): { owner: string; session: string; tab: string; wire: string } {
+  if (typeof value !== 'string' || !value.startsWith('dsh-tab:v1:') || value.length > 16_384) return refuse('BROWSER_HANDLE_STALE')
+  let parts: unknown
+  try { parts = JSON.parse(decodeURIComponent(value.slice(11))) }
+  catch (_error) { return refuse('BROWSER_HANDLE_STALE') }
+  if (!Array.isArray(parts) || parts.length !== 3 || parts.some(part => typeof part !== 'string' || part.length === 0)
+    || `dsh-tab:v1:${encodeURIComponent(JSON.stringify(parts))}` !== value) return refuse('BROWSER_HANDLE_STALE')
+  const [owner, session, id] = parts as [string, string, string]
+  return { owner, session, tab: id, wire: value }
+}
+
+interface Slot {
+  readonly admission: string
+  readonly renderer: WebContents
+  readonly scope: string
+  placement?: SidebarNativePlacement
+  lease?: DesktopNativeLease
+}
+
+interface Native {
+  readonly renderer: WebContents
+  readonly scope: string
+  readonly reservation: DesktopBrowserLeaseId
+  readonly view: WebContentsView
+  readonly container: View
+  generation: string
+  state: DesktopNativeState
+  slot?: SidebarNativeSlot
+  queue: Promise<unknown>
+  documentTimer?: ReturnType<typeof setTimeout>
+}
+
+const methods = new Set([
+  'Page.navigate', 'Page.reload', 'Page.stopLoading', 'Page.getFrameTree', 'Page.createIsolatedWorld',
+  'Page.getNavigationHistory', 'Page.navigateToHistoryEntry', 'Page.getLayoutMetrics', 'Page.captureScreenshot',
+  'Runtime.evaluate', 'Runtime.terminateExecution', 'Input.dispatchMouseEvent', 'Input.dispatchKeyEvent',
+  'Input.insertText', 'Network.getCookies',
+])
+
+/** Owns slots, leases, native objects and document generations for one product window. */
+export class DesktopNativeViews {
+  private readonly admissions = new Map<string, { renderer: WebContents; owner: string }>()
+  private readonly slots = new Map<SidebarNativeSlot, Slot>()
+  private readonly views = new Map<DesktopNativeLease, Native>()
+  private readonly releasing = new Map<DesktopNativeLease, { renderer: WebContents; completion: Promise<void> }>()
+
+  constructor(private readonly window: () => BrowserWindow | undefined, private readonly policy: DesktopBrowserGuests) {}
+
+  /** Authenticate in main.ts before dispatch; errors are serialized without private exceptions. */
+  async request(renderer: WebContents, input: unknown): Promise<object> {
+    try {
+      const request = record(input)
+      let result: unknown
+      switch (request.op) {
+        case 'enter': result = this.enter(renderer, request.owner); break
+        case 'leave': result = await this.leave(renderer, request.admission); break
+        case 'register': result = this.register(renderer, request.admission, request.scope); break
+        case 'update': result = this.update(renderer, request.slot, request.placement); break
+        case 'revoke': result = await this.revoke(renderer, request.slot); break
+        case 'acquire': result = this.acquire(renderer, request.scope, request.workspace); break
+        case 'attach': result = this.attach(renderer, request.lease, request.slot); break
+        case 'command': result = await this.command(renderer, request.lease, request.method, request.params); break
+        case 'release': result = await this.release(renderer, request.lease); break
+        default: return refuse('BROWSER_COMMAND_DENIED')
+      }
+      return { ok: true, result }
+    } catch (error) {
+      return { ok: false, code: error instanceof DesktopNativeViewError ? error.code : 'BROWSER_NATIVE_SURFACE_UNAVAILABLE',
+        message: error instanceof DesktopNativeViewError ? error.message : 'Native Sidebar operation failed' }
+    }
+  }
+
+  private enter(renderer: WebContents, owner: unknown): string {
+    if (typeof owner !== 'string' || owner.length === 0 || owner.length > 4096) return refuse('BROWSER_OWNER_UNKNOWN')
+    const id = randomUUID()
+    this.admissions.set(id, { renderer, owner })
+    return id
+  }
+
+  private async leave(renderer: WebContents, id: unknown): Promise<void> {
+    if (typeof id !== 'string') return refuse('BROWSER_OWNER_UNKNOWN')
+    const admission = this.admissions.get(id)
+    if (admission === undefined) return
+    if (admission.renderer !== renderer) return refuse('BROWSER_OWNER_UNKNOWN')
+    this.admissions.delete(id)
+    for (const [key, slot] of this.slots) if (slot.admission === id) await this.revoke(renderer, key)
+  }
+
+  private register(renderer: WebContents, admission: unknown, scope: unknown): SidebarNativeSlot {
+    const address = tab(scope)
+    const admitted = typeof admission === 'string' ? this.admissions.get(admission) : undefined
+    if (admitted === undefined || admitted.renderer !== renderer || admitted.owner !== address.owner) return refuse('BROWSER_OWNER_UNKNOWN')
+    if ([...this.slots.values()].some(slot => slot.renderer === renderer && slot.scope === address.wire)) return refuse('BROWSER_SLOT_UNAVAILABLE')
+    const id = randomUUID() as SidebarNativeSlot
+    this.slots.set(id, { renderer, scope: address.wire, admission: String(admission) })
+    return id
+  }
+
+  private slot(renderer: WebContents, id: unknown): Slot {
+    const slot = typeof id === 'string' ? this.slots.get(id as SidebarNativeSlot) : undefined
+    if (slot === undefined) return refuse('BROWSER_SLOT_UNAVAILABLE')
+    if (slot.renderer !== renderer) return refuse('BROWSER_OWNER_UNKNOWN')
+    return slot
+  }
+
+  private native(renderer: WebContents, id: unknown): Native {
+    const native = typeof id === 'string' ? this.views.get(id as DesktopNativeLease) : undefined
+    if (native === undefined || native.view.webContents.isDestroyed()) return refuse('BROWSER_GUEST_CLOSED')
+    if (native.renderer !== renderer) return refuse('BROWSER_OWNER_UNKNOWN')
+    return native
+  }
+
+  private update(renderer: WebContents, id: unknown, value: unknown): void {
+    const slot = this.slot(renderer, id)
+    const placement = record(value)
+    const { x, y, width, height, visible, background } = placement
+    if ([x, y, width, height].some(part => typeof part !== 'number' || !Number.isFinite(part))
+      || Number(width) < 0 || Number(height) < 0 || Number(width) > 100_000 || Number(height) > 100_000
+      || typeof visible !== 'boolean' || typeof background !== 'boolean' || (visible && background)) return refuse('BROWSER_SLOT_UNAVAILABLE')
+    slot.placement = { x: Number(x), y: Number(y), width: Number(width), height: Number(height), visible, background }
+    if (slot.lease !== undefined) this.compose(this.native(renderer, slot.lease), slot)
+  }
+
+  private acquire(renderer: WebContents, scope: unknown, workspace: unknown): { lease: DesktopNativeLease } {
+    const address = tab(scope)
+    const slot = [...this.slots.values()].find(item => item.scope === address.wire && item.renderer === renderer)
+    if (slot === undefined) return refuse('BROWSER_OWNER_UNKNOWN')
+    if ([...this.views.values()].some(view => view.scope === address.wire)) return refuse('BROWSER_HANDLE_STALE')
+    const window = this.window()
+    if (window === undefined || window.isDestroyed() || window.webContents !== renderer) return refuse('BROWSER_NATIVE_SURFACE_UNAVAILABLE')
+    const reservation = this.policy.acquire(renderer, workspace)
+    let view: WebContentsView
+    try {
+      view = new WebContentsView({ webPreferences: {
+        partition: reservation.partition, sandbox: true, contextIsolation: true, nodeIntegration: false,
+        nodeIntegrationInWorker: false, nodeIntegrationInSubFrames: false, webSecurity: true,
+        allowRunningInsecureContent: false, webviewTag: false, plugins: false, navigateOnDragDrop: false,
+        disableDialogs: true, backgroundThrottling: false,
+      } })
+      this.policy.bindNative(renderer, reservation.lease, view.webContents)
+    } catch (_error) {
+      void this.policy.release(renderer, reservation.lease).catch(error => console.error(error))
+      return refuse('BROWSER_NATIVE_SURFACE_UNAVAILABLE')
+    }
+    const lease = randomUUID() as DesktopNativeLease
+    const generation = randomUUID()
+    const native: Native = { renderer, scope: address.wire, reservation: reservation.lease, view,
+      container: new View(), generation, state: { stage: 'attached', generation }, queue: Promise.resolve() }
+    native.container.addChildView(view)
+    this.views.set(lease, native)
+    native.documentTimer = setTimeout(() => { this.fail(lease, native, 'BROWSER_SLOT_UNAVAILABLE') }, 15_000)
+    view.webContents.on('did-start-navigation', (_event, _url, inPlace, mainFrame) => {
+      if (mainFrame && !inPlace && this.views.get(lease) === native) {
+        native.generation = randomUUID()
+        clearTimeout(native.documentTimer)
+        native.documentTimer = setTimeout(() => { this.fail(lease, native, 'BROWSER_DOCUMENT_TIMEOUT') }, 15_000)
+        this.publish(lease, native, { stage: 'attached', generation: native.generation })
+      }
+    })
+    view.webContents.on('did-navigate', () => {
+      const generation = native.generation
+      void this.send(native, 'Page.getFrameTree').then((value) => {
+        const frame = record(record(record(value).frameTree).frame)
+        if (this.views.get(lease) === native && native.slot !== undefined && generation === native.generation
+          && typeof frame.id === 'string' && typeof frame.loaderId === 'string') {
+          clearTimeout(native.documentTimer)
+          this.publish(lease, native, { stage: 'document', generation, frameId: frame.id, loaderId: frame.loaderId })
+        }
+      }).catch((_error) => { if (this.views.get(lease) === native) this.fail(lease, native, 'BROWSER_DOCUMENT_UNACKNOWLEDGED') })
+    })
+    view.webContents.on('did-fail-load', (_event, code, _description, _url, mainFrame) => {
+      if (mainFrame && code !== -3) this.fail(lease, native, 'BROWSER_DOCUMENT_UNACKNOWLEDGED')
+    })
+    view.webContents.on('render-process-gone', () => { this.fail(lease, native, 'BROWSER_GUEST_CLOSED') })
+    view.webContents.once('destroyed', () => {
+      clearTimeout(native.documentTimer)
+      if (this.views.get(lease) === native) {
+        this.publish(lease, native, { stage: 'closed', generation: native.generation })
+        this.views.delete(lease)
+        if (native.slot !== undefined) this.slots.delete(native.slot)
+      }
+      this.detach(native)
+    })
+    return { lease }
+  }
+
+  private publish(lease: DesktopNativeLease, native: Native, state: DesktopNativeState): void {
+    native.state = state
+    if (!native.renderer.isDestroyed()) native.renderer.send(DESKTOP_IPC.nativeViewState, { lease, state })
+  }
+
+  private fail(lease: DesktopNativeLease, native: Native, code: Failure): void {
+    if (this.views.get(lease) !== native) return
+    this.publish(lease, native, { stage: 'failed', generation: native.generation, code })
+    void this.release(native.renderer, lease).catch(error => console.error(error))
+  }
+
+  private attach(renderer: WebContents, id: unknown, slotId: unknown): void {
+    const native = this.native(renderer, id)
+    const slot = this.slot(renderer, slotId)
+    if (slot.scope !== native.scope || (slot.lease !== undefined && slot.lease !== id)
+      || (native.slot !== undefined && native.slot !== slotId) || slot.placement === undefined) return refuse('BROWSER_SLOT_UNAVAILABLE')
