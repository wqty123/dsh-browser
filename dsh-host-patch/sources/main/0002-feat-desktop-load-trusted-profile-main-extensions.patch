diff --git a/apps/desktop/tests/main-extensions.spec.ts b/apps/desktop/tests/main-extensions.spec.ts
new file mode 100644
index 0000000000..dcede605ce
--- /dev/null
+++ b/apps/desktop/tests/main-extensions.spec.ts
@@ -0,0 +1,123 @@
+import { EventEmitter } from 'node:events'
+import { mkdtemp, mkdir, readFile, realpath, rm, symlink, writeFile } from 'node:fs/promises'
+import { tmpdir } from 'node:os'
+import { join } from 'node:path'
+import type { App } from 'electron'
+import { afterEach, expect, it, vi } from 'vitest'
+import { discoverDesktopMainExtensions, startDesktopMainExtensions, type DesktopMainExtensionApi } from '../src/main-extensions.ts'
+
+const roots: string[] = []
+afterEach(async () => {
+  vi.restoreAllMocks()
+  await Promise.all(roots.splice(0).map(root => rm(root, { recursive: true, force: true })))
+})
+
+async function fixture(dependencies: Record<string, string> = {}) {
+  const root = await realpath(await mkdtemp(join(tmpdir(), 'dsh-main-extensions-')))
+  roots.push(root)
+  await writeFile(join(root, 'package.json'), JSON.stringify({ dependencies }))
+  return root
+}
+
+async function plugin(root: string, name: string, main: unknown, source = 'export function start() {}') {
+  const directory = join(root, 'node_modules', name)
+  await mkdir(directory, { recursive: true })
+  await writeFile(join(directory, 'package.json'), JSON.stringify({ type: 'module', dsh: { desktop: { main } } }))
+  await writeFile(join(directory, 'entry.mjs'), source)
+  return directory
+}
+
+it('discovers only opted-in direct dependencies, including scoped packages', async () => {
+  const root = await fixture({ '@test/browser': '*', ordinary: '*' })
+  const browser = await plugin(root, '@test/browser', './entry.mjs')
+  await plugin(root, 'ordinary', undefined)
+  await plugin(root, 'not-installed-directly', './entry.mjs')
+  const report = vi.fn()
+  expect(await discoverDesktopMainExtensions(root, report)).toEqual([{ name: '@test/browser', entry: join(browser, 'entry.mjs') }])
+  expect(report).not.toHaveBeenCalled()
+})
+
+it('accepts absent profiles and profiles without dependencies', async () => {
+  const root = await fixture()
+  const report = vi.fn()
+  expect(await discoverDesktopMainExtensions(root, report)).toEqual([])
+  expect(await discoverDesktopMainExtensions(join(root, 'absent'), report)).toEqual([])
+  expect(report).not.toHaveBeenCalled()
+})
+
+it('rejects malformed entries, traversal, absolute paths, and symlink escapes without losing valid entries', async () => {
+  const root = await fixture({ traversal: '*', absolute: '*', malformed: '*', linked: '*', missing: '*', good: '*' })
+  await plugin(root, 'traversal', './../good/entry.mjs')
+  await plugin(root, 'absolute', join(root, 'entry.mjs'))
+  await plugin(root, 'malformed', 12)
+  const linked = await plugin(root, 'linked', './escape/entry.mjs')
+  const good = await plugin(root, 'good', './entry.mjs')
+  await symlink(good, join(linked, 'escape'), 'junction')
+  const report = vi.fn()
+  expect(await discoverDesktopMainExtensions(root, report)).toEqual([{ name: 'good', entry: join(good, 'entry.mjs') }])
+  expect(report.mock.calls.map(([name]) => name)).toEqual(['traversal', 'absolute', 'malformed', 'linked', 'missing'])
+})
+
+it('reports malformed profile JSON', async () => {
+  const root = await fixture()
+  await writeFile(join(root, 'package.json'), '{')
+  const report = vi.fn()
+  expect(await discoverDesktopMainExtensions(root, report)).toEqual([])
+  expect(report).toHaveBeenCalledWith('profile', expect.any(SyntaxError))
+})
+
+it('rejects dependency names that could escape node_modules', async () => {
+  const root = await fixture({ '../escape': '*', '@scope/..': '*' })
+  const report = vi.fn()
+  expect(await discoverDesktopMainExtensions(root, report)).toEqual([])
+  expect(report.mock.calls.map(([name]) => name)).toEqual(['../escape', '@scope/..'])
+})
+
+it('cleans up a start that completes while the application is quitting', async () => {
+  const root = await fixture({ late: '*' })
+  await plugin(root, 'late', './entry.mjs', `
+    import { writeFileSync } from 'node:fs'
+    import { join } from 'node:path'
+    export function start(api) {
+      api.app.emit('will-quit')
+      return () => writeFileSync(join(api.dshHome, 'stopped'), 'late')
+    }
+  `)
+  const app = new EventEmitter() as App
+  const dispose = await startDesktopMainExtensions(root, {
+    app, webContents: {} as DesktopMainExtensionApi['webContents'], mainWindow: () => undefined, dshHome: root,
+  })
+  expect(await readFile(join(root, 'stopped'), 'utf8')).toBe('late')
+  expect(app.listenerCount('will-quit')).toBe(0)
+  dispose()
+})
+
+it('starts entries with capabilities and isolates startup and cleanup failures', async () => {
+  const root = await fixture({ bad: '*', missing: '*', object: '*', fn: '*' })
+  await plugin(root, 'bad', './entry.mjs', 'export function start() { throw new Error("startup failed") }')
+  await plugin(root, 'missing', './entry.mjs', 'export const other = 1')
+  await plugin(root, 'object', './entry.mjs', `
+    import { writeFileSync } from 'node:fs'
+    import { join } from 'node:path'
+    export function start(api) {
+      writeFileSync(join(api.dshHome, 'started'), String(api.mainWindow()) + ':' + typeof api.webContents)
+      return { dispose() { throw new Error('cleanup failed') } }
+    }
+  `)
+  await plugin(root, 'fn', './entry.mjs', `
+    import { appendFileSync } from 'node:fs'
+    import { join } from 'node:path'
+    export function start(api) { return () => appendFileSync(join(api.dshHome, 'stopped'), 'once') }
+  `)
+  const app = new EventEmitter() as App
+  const api: DesktopMainExtensionApi = { app, webContents: {} as DesktopMainExtensionApi['webContents'], mainWindow: () => undefined, dshHome: root }
+  const errors = vi.spyOn(console, 'error').mockImplementation(() => {})
+  const dispose = await startDesktopMainExtensions(root, api)
+  expect(await readFile(join(root, 'started'), 'utf8')).toBe('undefined:object')
+  expect(errors.mock.calls.map(([message]) => message)).toEqual(['desktop main extension bad:', 'desktop main extension missing:'])
+  app.emit('will-quit')
+  dispose()
+  expect(app.listenerCount('will-quit')).toBe(0)
+  expect(await readFile(join(root, 'stopped'), 'utf8')).toBe('once')
+  expect(errors).toHaveBeenLastCalledWith('desktop main extension object:', expect.objectContaining({ message: 'cleanup failed' }))
+})
