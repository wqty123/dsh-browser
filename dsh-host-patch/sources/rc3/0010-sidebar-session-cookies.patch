   /** @param hostUrl - current authenticated DSH Host, which guests cannot request. */
   constructor(private readonly hostUrl: () => string | undefined, private readonly dshHome?: string) {}
 
+  /** Restore session cookies before exposing the persistent partition to either guest carrier. */
+  preparePersistent(): Promise<void> {
+    if (this.closing) return Promise.reject(new HarnessError('Sidebar storage is shutting down', 'BROWSER_GUEST_CLOSED'))
+    this.persistence ??= (async () => {
+      if (this.dshHome === undefined) {
+        throw new HarnessError('Persistent Sidebar storage is unavailable', 'BROWSER_PERSISTENT_SESSION_UNAVAILABLE')
+      }
+      const partition = `persist:dsh-sidebar-browser-${createHash('sha256').update(this.dshHome).digest('hex')}`
+      const cookies = SidebarSessionCookies.forSession(session.fromPartition(partition), this.dshHome)
+      await cookies.restore()
+      this.cookieStore = cookies
+    })()
+    return this.persistence
+  }
+
+  /** Reconcile before a host cookie-changing operation reports completion. */
+  async reconcilePersistent(): Promise<void> {
+    await this.persistence
+    await this.cookieStore?.flush()
+  }
+
+  /** Stop admission before draining storage for partition teardown. */
+  async shutdown(): Promise<void> {
+    this.closing = true
+    await this.persistence
+    await this.cookieStore?.shutdown()
+  }
+
   /**
    * Reserve a guest in workspace memory storage or opt-in persistent profile storage.
    * @param owner - authenticated primary application WebContents.
