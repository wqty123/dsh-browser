diff --git a/apps/desktop/src/sidebar-session-cookies.ts b/apps/desktop/src/sidebar-session-cookies.ts
new file mode 100644
index 0000000000..6299fe233f
--- /dev/null
+++ b/apps/desktop/src/sidebar-session-cookies.ts
@@ -0,0 +1,164 @@
+import { execFile } from 'node:child_process'
+import { chmod, mkdir, readFile } from 'node:fs/promises'
+import { dirname, join } from 'node:path'
+import { promisify } from 'node:util'
+import type { Cookie, CookiesSetDetails, Session } from 'electron'
+import { z } from 'zod'
+import { writeFileAtomic } from '@deepseek-ai/dsh-atomic-write'
+import { HarnessError } from '@deepseek-ai/dsh-error'
+
+const cookieRecord = z.object({ name: z.string(), value: z.string(), domain: z.string().min(1),
+  path: z.string().startsWith('/'), secure: z.boolean(), httpOnly: z.boolean(), hostOnly: z.boolean(),
+  sameSite: z.enum(['unspecified', 'no_restriction', 'lax', 'strict']), session: z.literal(true),
+  expirationDate: z.never().optional(),
+}).strict()
+type SavedCookie = z.infer<typeof cookieRecord>
+const sidecar = z.object({ version: z.literal(1), cookies: z.array(z.unknown()) })
+const stores = new WeakMap<Session['cookies'], SidebarSessionCookies>()
+
+function details(cookie: SavedCookie): CookiesSetDetails {
+  const domain = cookie.domain.replace(/^\./, '')
+  const host = domain.includes(':') && !domain.startsWith('[') ? `[${domain}]` : domain
+  const url = new URL(`${cookie.secure ? 'https:' : 'http:'}//${host}/`)
+  if (url.username || url.password || url.port || url.hostname.toLowerCase() !== host.toLowerCase()) {
+    throw new HarnessError('Unsupported Sidebar cookie scope', 'BROWSER_PERSISTENT_SESSION_UNAVAILABLE')
+  }
+  url.pathname = cookie.path
+  return { url: url.href, name: cookie.name, value: cookie.value, path: cookie.path,
+    secure: cookie.secure, httpOnly: cookie.httpOnly, sameSite: cookie.sameSite,
+    ...cookie.hostOnly ? {} : { domain: cookie.domain } }
+}
+
+function key(cookie: Pick<Cookie, 'domain' | 'path' | 'name'>): string {
+  return JSON.stringify([cookie.domain?.replace(/^\./, '').toLowerCase(), cookie.path, cookie.name])
+}
+
+/** Partition-local session-cookie checkpoints; Chromium retains expiring cookies. */
+export class SidebarSessionCookies {
+  static forSession(browserSession: Pick<Session, 'cookies'>, home: string): SidebarSessionCookies {
+    const existing = stores.get(browserSession.cookies)
+    if (existing !== undefined) {
+      if (existing.file !== join(home, 'dsh-builtin-browser-host', 'desktop-session-cookies.json')) throw existing.failure()
+      return existing
+    }
+    const store = new SidebarSessionCookies(browserSession, home)
+    stores.set(browserSession.cookies, store)
+    return store
+  }
+
+  private writes = Promise.resolve()
+  private readonly file: string
+  private ready = false
+  private disposed = false
+  private permissions: Promise<void> | undefined
+  private lastSnapshot: string | undefined
+  private restoration: Promise<void> | undefined
+  private readonly changed = (): void => {
+    if (this.ready && !this.disposed) void this.flush().catch(() => { this.warn() })
+  }
+
+  private constructor(private readonly browserSession: Pick<Session, 'cookies'>, home: string) {
+    this.file = join(home, 'dsh-builtin-browser-host', 'desktop-session-cookies.json')
+  }
+
+  private async protect(): Promise<void> {
+    await mkdir(dirname(this.file), { recursive: true, mode: 0o700 })
+    if (process.platform !== 'win32') {
+      await chmod(dirname(this.file), 0o700)
+      return
+    }
+    const script = [
+      '$ErrorActionPreference="Stop"',
+      '$u=[Security.Principal.WindowsIdentity]::GetCurrent().User',
+      '$d=New-Object Security.AccessControl.DirectorySecurity',
+      '$d.SetOwner($u)', '$d.SetAccessRuleProtection($true,$false)',
+      '$r=New-Object Security.AccessControl.FileSystemAccessRule($u,"FullControl","ContainerInherit,ObjectInherit","None","Allow")',
+      '$d.AddAccessRule($r)', 'Set-Acl -LiteralPath $env:DSH_SIDECAR_DIRECTORY -AclObject $d',
+      'if(Test-Path -LiteralPath $env:DSH_SIDECAR_FILE){'
+        + '$f=New-Object Security.AccessControl.FileSecurity;'
+        + '$f.SetOwner($u);$f.SetAccessRuleProtection($true,$false);'
+        + '$f.AddAccessRule((New-Object Security.AccessControl.FileSystemAccessRule($u,"FullControl","Allow")));'
+        + 'Set-Acl -LiteralPath $env:DSH_SIDECAR_FILE -AclObject $f}',
+    ].join(';')
+    const powershell = join(process.env.SystemRoot ?? 'C:\\Windows', 'System32', 'WindowsPowerShell', 'v1.0', 'powershell.exe')
+    await promisify(execFile)(powershell, ['-NoProfile', '-NonInteractive', '-EncodedCommand', Buffer.from(script, 'utf16le').toString('base64')], {
+      windowsHide: true, timeout: 10_000,
+      env: { ...process.env, DSH_SIDECAR_DIRECTORY: dirname(this.file), DSH_SIDECAR_FILE: this.file },
+    })
+  }
+
+  /** Listen before reading; gate checkpoints until individually valid entries are restored. */
+  restore(): Promise<void> {
+    this.restoration ??= this.initialize()
+    return this.restoration
+  }
+
+  private async initialize(): Promise<void> {
+    this.browserSession.cookies.on('changed', this.changed)
+    let saved: unknown[] = []
+    try {
+      this.permissions ??= this.protect()
+      await this.permissions
+      saved = sidecar.parse(JSON.parse(await readFile(this.file, 'utf8'))).cookies
+    } catch (error) {
+      if ((error as NodeJS.ErrnoException).code !== 'ENOENT') this.warn()
+    }
+    try {
+      const persistent = new Set((await this.browserSession.cookies.get({ session: false })).map(key))
+      for (const entry of saved) {
+        const parsed = cookieRecord.safeParse(entry)
+        if (!parsed.success) { this.warn(); continue }
+        if (persistent.has(key(parsed.data))) continue
+        try { await this.browserSession.cookies.set(details(parsed.data)) }
+        catch (_unsupportedCookie) { this.warn() }
+      }
+    } catch (_unavailableCookies) { this.warn() }
+    this.ready = true
+    await this.flush().catch(() => { this.warn() })
+  }
+
+  /** Await after host cookie mutations/logout, including deletion and replacement. */
+  flush(): Promise<void> {
+    if (!this.ready || this.disposed) return this.writes
+    this.writes = this.writes.catch(() => undefined).then(async () => {
+      this.permissions ??= this.protect()
+      await this.permissions
+      const cookies: SavedCookie[] = []
+      for (const value of await this.browserSession.cookies.get({ session: true })) {
+        const parsed = cookieRecord.safeParse(value)
+        if (!parsed.success) { this.warn(); continue }
+        try { details(parsed.data); cookies.push(parsed.data) }
+        catch (_unsupportedScope) { this.warn() }
+      }
+      const raw = JSON.stringify({ version: 1, cookies })
+      if (raw === this.lastSnapshot) return
+      await writeFileAtomic(this.file, raw, { mode: 0o600, dirMode: 0o700 })
+      this.lastSnapshot = raw
+    }).catch(() => { throw this.failure() })
+    return this.writes
+  }
+
+  /** Drain changes, checkpoint, flush Chromium, then detach the listener. */
+  async shutdown(): Promise<void> {
+    try {
+      await this.flush()
+    } finally {
+      try {
+        await this.browserSession.cookies.flushStore()
+        let pending = this.writes
+        await pending
+        while (pending !== this.writes) { pending = this.writes; await pending }
+      } finally {
+        this.disposed = true
+        this.browserSession.cookies.removeListener('changed', this.changed)
+        stores.delete(this.browserSession.cookies)
+      }
+    }
+  }
+
+  private warn(): void { console.error('Sidebar session-cookie checkpoint unavailable or unsupported; cookie values omitted') }
+
+  private failure(): HarnessError {
+    return new HarnessError('Sidebar session cookie storage is unavailable', 'BROWSER_PERSISTENT_SESSION_UNAVAILABLE')
+  }
+}
