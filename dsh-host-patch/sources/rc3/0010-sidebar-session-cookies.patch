index 0000000000..22bd3dbcc5
--- /dev/null
+++ b/apps/desktop/tests/sidebar-session-cookies.spec.ts
@@ -0,0 +1,186 @@
+import { EventEmitter } from 'node:events'
+import { mkdir, mkdtemp, readFile, rm, stat, writeFile } from 'node:fs/promises'
+import { tmpdir } from 'node:os'
+import { dirname, join } from 'node:path'
+import type { Cookie, CookiesGetFilter, CookiesSetDetails, Session } from 'electron'
+import { afterEach, expect, it, vi } from 'vitest'
+import { writeFileAtomic } from '@deepseek-ai/dsh-atomic-write'
+import { SidebarSessionCookies } from '../src/sidebar-session-cookies.ts'
+
+vi.mock('@deepseek-ai/dsh-atomic-write', async (importOriginal) => {
+  const actual = await importOriginal<typeof import('@deepseek-ai/dsh-atomic-write')>()
+  return { ...actual, writeFileAtomic: vi.fn(actual.writeFileAtomic) }
+})
+vi.mock('node:fs/promises', async (importOriginal) => {
+  const actual = await importOriginal<typeof import('node:fs/promises')>()
+  return { ...actual, readFile: vi.fn(actual.readFile) }
+})
+
+const homes: string[] = []
+afterEach(async () => {
+  vi.restoreAllMocks()
+  vi.clearAllMocks()
+  await Promise.all(homes.splice(0).map(home => rm(home, { recursive: true, force: true })))
+})
+const login: Cookie = { name: 'login', value: '"session-secret"', domain: 'example.com',
+  hostOnly: true, path: '/', secure: true, httpOnly: true, session: true, sameSite: 'lax' }
+
+async function fixture(values: Cookie[] = [], existingHome?: string) {
+  const home = existingHome ?? await mkdtemp(join(tmpdir(), 'sidebar-session-cookies-'))
+  if (existingHome === undefined) homes.push(home)
+  const cookies = Object.assign(new EventEmitter(), {
+    get: vi.fn(async (filter: CookiesGetFilter) => values.filter(cookie => cookie.session === filter.session)),
+    set: vi.fn(async (details: CookiesSetDetails) => {
+      const cookie: Cookie = { name: details.name ?? '', value: details.value ?? '',
+        domain: details.domain ?? new URL(details.url).hostname, hostOnly: details.domain === undefined,
+        path: details.path ?? '/', secure: details.secure === true, httpOnly: details.httpOnly === true,
+        sameSite: details.sameSite ?? 'unspecified', session: true }
+      values.push(cookie)
+      cookies.emit('changed', {}, cookie, 'explicit', false)
+    }),
+    flushStore: vi.fn(async () => {}),
+  })
+  const store = SidebarSessionCookies.forSession({ cookies: cookies as Session['cookies'] }, home)
+  const file = join(home, 'dsh-builtin-browser-host', 'desktop-session-cookies.json')
+  await mkdir(dirname(file), { recursive: true })
+  return { home, file, store, cookies, values }
+}
+async function snapshot(file: string) { return JSON.parse(await readFile(file, 'utf8')) }
+
+it('checkpoints only session cookies and restores quoted host-only values without expiry', async () => {
+  const f = await fixture([login, { ...login, name: 'durable', session: false, expirationDate: 2e10 }])
+  await f.store.restore()
+  expect((await snapshot(f.file)).cookies).toEqual([login])
+  expect(f.cookies.get).toHaveBeenCalledWith({ session: true })
+  if (process.platform !== 'win32') {
+    expect((await stat(f.file)).mode & 0o777).toBe(0o600)
+    expect((await stat(dirname(f.file))).mode & 0o777).toBe(0o700)
+  }
+  const restarted = await fixture([], f.home)
+  await restarted.store.restore()
+  expect(restarted.cookies.set).toHaveBeenCalledExactlyOnceWith({ url: 'https://example.com/',
+    name: 'login', value: '"session-secret"', path: '/', secure: true, httpOnly: true, sameSite: 'lax' })
+  expect(restarted.values[0]?.session).toBe(true)
+})
+
+it('restores domain scope and URL-encodes path characters without changing the cookie path', async () => {
+  const f = await fixture()
