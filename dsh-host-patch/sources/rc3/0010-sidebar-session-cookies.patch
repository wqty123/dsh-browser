+  const gate = Promise.withResolvers<undefined>()
+  const reconcile = vi.spyOn(f.policy, 'reconcilePersistent').mockReturnValue(gate.promise)
+  let completed = false
+  const pending = f.service.command(f.renderer, lease, method, method === 'Storage.setCookies' ? { cookies: [] } : {})
