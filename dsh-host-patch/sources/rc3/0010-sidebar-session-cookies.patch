+  gate.resolve(undefined)
+  await Promise.all([restoring, f.store.restore()])
+  const samePartition = SidebarSessionCookies.forSession({ cookies: f.cookies as Session['cookies'] }, f.home)
+  expect(samePartition).toBe(f.store)
+  await samePartition.restore()
+  expect(f.cookies.listenerCount('changed')).toBe(1)
