Subject: [PATCH] fix(desktop): retry cookie protection without failing guest
 commands

Co-Authored-By: Devin AI <158243242+devin-ai-integration[bot]@users.noreply.github.com>
---
 apps/desktop/src/browser-guests.ts               |  2 +-
 apps/desktop/src/sidebar-session-cookies.ts      | 14 ++++++++++----
 apps/desktop/tests/browser-partitions.spec.ts    | 16 ++++++++++++++++
 .../tests/sidebar-session-cookies.spec.ts        | 13 ++++++++++++-
 4 files changed, 39 insertions(+), 6 deletions(-)

diff --git a/apps/desktop/src/browser-guests.ts b/apps/desktop/src/browser-guests.ts
index 1809138ea1..814904694f 100644
--- a/apps/desktop/src/browser-guests.ts
+++ b/apps/desktop/src/browser-guests.ts
@@ -43,7 +43,7 @@ export class DesktopBrowserGuests {
   /** Reconcile before a host cookie-changing operation reports completion. */
   async reconcilePersistent(): Promise<void> {
     await this.persistence
-    await this.cookieStore?.flush()
+    await this.cookieStore?.flush().catch(() => { console.error('Sidebar cookie reconciliation failed') })
   }
 
   /** Stop admission before draining storage for partition teardown. */
diff --git a/apps/desktop/src/sidebar-session-cookies.ts b/apps/desktop/src/sidebar-session-cookies.ts
index 6299fe233f..e33ac289b4 100644
--- a/apps/desktop/src/sidebar-session-cookies.ts
+++ b/apps/desktop/src/sidebar-session-cookies.ts
@@ -87,6 +87,14 @@ export class SidebarSessionCookies {
     })
   }
 
+  private protection(): Promise<void> {
+    this.permissions ??= this.protect().catch((error) => {
+      this.permissions = undefined
+      throw error
+    })
+    return this.permissions
+  }
+
   /** Listen before reading; gate checkpoints until individually valid entries are restored. */
   restore(): Promise<void> {
     this.restoration ??= this.initialize()
@@ -97,8 +105,7 @@ export class SidebarSessionCookies {
     this.browserSession.cookies.on('changed', this.changed)
     let saved: unknown[] = []
     try {
-      this.permissions ??= this.protect()
-      await this.permissions
+      await this.protection()
       saved = sidecar.parse(JSON.parse(await readFile(this.file, 'utf8'))).cookies
     } catch (error) {
       if ((error as NodeJS.ErrnoException).code !== 'ENOENT') this.warn()
@@ -121,8 +128,7 @@ export class SidebarSessionCookies {
   flush(): Promise<void> {
     if (!this.ready || this.disposed) return this.writes
     this.writes = this.writes.catch(() => undefined).then(async () => {
-      this.permissions ??= this.protect()
-      await this.permissions
+      await this.protection()
       const cookies: SavedCookie[] = []
       for (const value of await this.browserSession.cookies.get({ session: true })) {
         const parsed = cookieRecord.safeParse(value)
diff --git a/apps/desktop/tests/browser-partitions.spec.ts b/apps/desktop/tests/browser-partitions.spec.ts
index 7c3500a943..0e1dfa32da 100644
--- a/apps/desktop/tests/browser-partitions.spec.ts
+++ b/apps/desktop/tests/browser-partitions.spec.ts
@@ -2,6 +2,9 @@ import { expect, it, vi } from 'vitest'
 import type { WebContents } from 'electron'
 import { DesktopBrowserGuests } from '../src/browser-guests.ts'
 
+const checkpoints = vi.hoisted(() => ({ restore: vi.fn(async () => {}), flush: vi.fn(async () => {}) }))
+vi.mock('../src/sidebar-session-cookies.ts', () => ({ SidebarSessionCookies: { forSession: () => checkpoints } }))
+
 vi.mock('electron', () => ({ app: {}, session: { fromPartition: vi.fn(() => ({
   setPermissionRequestHandler() {}, setPermissionCheckHandler() {}, setDevicePermissionHandler() {},
   setDisplayMediaRequestHandler() {}, on() {}, webRequest: { onBeforeRequest() {} },
@@ -34,3 +37,16 @@ it('stops all guest admission before shutdown completes without clearing storage
   await expect(policy.preparePersistent()).rejects.toMatchObject({ code: 'BROWSER_GUEST_CLOSED' })
   await closing
 })
+
+it('reports checkpoint failures without rejecting guest evaluation and retries on the next operation', async () => {
+  const policy = new DesktopBrowserGuests(() => undefined, '/profiles/one')
+  const warning = vi.spyOn(console, 'error').mockImplementation(() => {})
+  try {
+    await policy.preparePersistent()
+    checkpoints.flush.mockRejectedValueOnce(new Error('session-secret'))
+    await expect(policy.reconcilePersistent()).resolves.toBeUndefined()
+    expect(warning).toHaveBeenCalledExactlyOnceWith('Sidebar cookie reconciliation failed')
+    await expect(policy.reconcilePersistent()).resolves.toBeUndefined()
+    expect(checkpoints.flush).toHaveBeenCalledTimes(2)
+  } finally { warning.mockRestore() }
+})
diff --git a/apps/desktop/tests/sidebar-session-cookies.spec.ts b/apps/desktop/tests/sidebar-session-cookies.spec.ts
index 22bd3dbcc5..d9206d348d 100644
--- a/apps/desktop/tests/sidebar-session-cookies.spec.ts
+++ b/apps/desktop/tests/sidebar-session-cookies.spec.ts
@@ -13,7 +13,7 @@ vi.mock('@deepseek-ai/dsh-atomic-write', async (importOriginal) => {
 })
 vi.mock('node:fs/promises', async (importOriginal) => {
   const actual = await importOriginal<typeof import('node:fs/promises')>()
-  return { ...actual, readFile: vi.fn(actual.readFile) }
+  return { ...actual, readFile: vi.fn(actual.readFile), mkdir: vi.fn(actual.mkdir) }
 })
 
 const homes: string[] = []
@@ -171,6 +171,17 @@ it('retains the previous complete checkpoint on write failure and can retry', as
   expect((await snapshot(f.file)).cookies).toEqual([])
 })
 
+it('retries permission protection after failed restoration and checkpoint attempts', async () => {
+  const f = await fixture([login])
+  const warning = vi.spyOn(console, 'error').mockImplementation(() => {})
+  vi.mocked(mkdir).mockRejectedValueOnce(new Error('session-secret')).mockRejectedValueOnce(new Error('session-secret'))
+  await expect(f.store.restore()).resolves.toBeUndefined()
+  await expect(readFile(f.file)).rejects.toMatchObject({ code: 'ENOENT' })
+  await expect(f.store.flush()).resolves.toBeUndefined()
+  expect((await snapshot(f.file)).cookies).toEqual([login])
+  expect(JSON.stringify(warning.mock.calls)).not.toContain('session-secret')
+})
+
 it('drains queued changes and final snapshot before Chromium flush and listener disposal', async () => {
   const f = await fixture([login])
   await f.store.restore()
