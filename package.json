{
  "name": "dsh-builtin-browser",
  "version": "0.7.42",
  "description": "Sidebar browser for DeepSeek Harness with navigation, structured references and dsh_browser_* tools. Browser tools require a controllable host-provided sidebar. External Chrome or Edge requires explicit opt-in; no standalone Electron fallback.",
  "keywords": [
    "browser",
    "cdp",
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "sidebar-browser",
    "startpage"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/morlay/dsh-plugin.git"
  },
  "files": [
    "lib",
    "dist",
    "src",
    "scripts",
    "tools/accept-desktop.mjs",
    "desktop-bridge",
    "cordis.patch.yml",
    "CHANGELOG.md",
    "README.md",
    "docs",
    "skills",
    "assets",
    "!src/**/__tests__"
  ],
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./browser": "./src/browser/runtime.ts",
    "./browser-electron": "./src/browser-electron/entry.ts",
    "./tool-browser": "./src/tool-browser/index.ts",
    "./startpage": "./src/startpage.ts",
    "./client": "./src/client/index.ts",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "exports": {
      ".": "./lib/index.js",
      "./browser": "./lib/browser/runtime.js",
      "./browser-electron": "./lib/browser-electron/entry.js",
      "./tool-browser": "./lib/tool-browser/index.js",
      "./startpage": "./lib/startpage.js",
      "./client": "./dist/client.cjs",
      "./cordis.patch.yml": "./cordis.patch.yml",
      "./package.json": "./package.json"
    }
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "prepack": "node scripts/build.mjs"
  },
  "bin": {
    "dsh-browser-install-electron": "scripts/install-electron.mjs"
  },
  "dependencies": {},
  "peerDependencies": {
    "@deepseek-ai/cordis": "workspace:^",
    "@deepseek-ai/dsh-llm": "workspace:^",
    "@deepseek-ai/dsh-system-prompt": "workspace:^",
    "@deepseek-ai/dsh-tools": "workspace:^",
    "@deepseek-ai/schemastery": "workspace:^"
  },
  "devDependencies": {
    "@deepseek-ai/dsh-api-workspace-controller": "workspace:^",
    "@deepseek-ai/dsh-brand": "workspace:^",
    "@deepseek-ai/dsh-client-locale": "workspace:^",
    "@deepseek-ai/dsh-client-shortcuts": "workspace:^",
    "@deepseek-ai/dsh-client-store": "workspace:^",
    "@deepseek-ai/dsh-client-ui-context-menu": "workspace:^",
    "@deepseek-ai/dsh-client-ui-conversation": "workspace:^",
    "@deepseek-ai/dsh-client-ui-dockkit": "workspace:^",
    "@deepseek-ai/dsh-client-ui-primitives": "workspace:^",
    "@deepseek-ai/dsh-client-ui-renderer": "workspace:^",
    "@deepseek-ai/dsh-client-ui-session": "workspace:^",
    "@deepseek-ai/dsh-client-ui-settings": "workspace:^",
    "@deepseek-ai/dsh-client-ui-sidebar-right": "workspace:^",
    "@deepseek-ai/dsh-client-ui-slots": "workspace:^",
    "@deepseek-ai/dsh-session": "workspace:^",
    "@deepseek-ai/dsh-settings": "workspace:^",
    "@types/node": "^22.0.0",
    "react-dom": "^18.2.0",
    "typescript": "^5.5.0"
  },
  "engines": {
    "dsh": ">=0.1.1-rc.2 <0.3.0"
  },
  "dsh": {
    "desktop": {
      "main": "./desktop-bridge/main.mjs"
    },
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-shortcuts",
        "@deepseek-ai/dsh-client-ui-context-menu",
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-primitives",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-ui-sidebar-right",
        "@deepseek-ai/dsh-client-ui-slots"
      ]
    }
  }
}
