{
  "name": "dsh-builtin-browser",
  "version": "0.1.16",
  "description": "Shared real browser plugin for DeepSeek Harness: install-and-use — a visible native browser the human can take over, driven by the agent over CDP. DOM-level interaction (React/Vue safe), per-task session isolation, cookie persistence (browser_auth), CAPTCHA detection, batch form fill (browser_fill), authenticated download, history/replay, action restriction",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./browser": {
      "types": "./lib/browser/runtime.d.ts",
      "default": "./lib/browser/runtime.js"
    },
    "./browser-electron": {
      "types": "./lib/browser-electron/entry.d.ts",
      "default": "./lib/browser-electron/entry.js"
    },
    "./tool-browser": {
      "types": "./lib/tool-browser/index.d.ts",
      "default": "./lib/tool-browser/index.js"
    },
    "./host-main": {
      "default": "./lib/browser-electron/host-main.js"
    },
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "src",
    "docs",
    "cordis.patch.yml",
    "README.md",
    "README.en.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "tsc -p tsconfig.json && node --test \"tests/*.test.mjs\"",
    "prepack": "npm run build"
  },
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "browser",
    "cdp"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/wqty123/dsh-browser.git"
  },
  "homepage": "https://github.com/wqty123/dsh-browser",
  "bugs": {
    "url": "https://github.com/wqty123/dsh-browser/issues"
  },
  "engines": {
    "node": ">=22.19"
  },
  "dependencies": {},
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-llm": "^0.1.1-rc.2",
    "@deepseek-ai/dsh-tools": "^0.1.1-rc.2",
    "@deepseek-ai/dsh-system-prompt": "^0.1.1-rc.2",
    "@deepseek-ai/schemastery": "^3.18.1",
    "electron": ">= 30.0.0"
  },
  "peerDependenciesMeta": {
    "electron": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.5.0"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  }
}
